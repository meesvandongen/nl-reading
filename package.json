{
  "name": "nl-reading",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Read Dutch with tap-to-look-up dictionary, de/het and verb help, audio, translations and SRS flashcards. A PWA hosted on Cloudflare Workers.",
  "scripts": {
    "dev": "pnpm run build:content && vp dev",
    "data": "node scripts/build-dict.mjs",
    "build:content": "vpx scripts/build-content.ts",
    "audit": "vpx scripts/audit-content.ts",
    "build": "pnpm run build:content && tsc --noEmit && vp build",
    "build:cf": "(git rev-parse --is-shallow-repository | grep -q true && git fetch --unshallow --quiet); pnpm run data && pnpm run build",
    "preview": "vp preview",
    "deploy": "wrangler deploy",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.4",
    "marked": "^18.1.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
