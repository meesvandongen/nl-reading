{
  "name": "nl-reading",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Read Dutch with tap-to-look-up dictionary, de/het and verb help, audio, translations and SRS flashcards. A PWA hosted on Cloudflare Workers.",
  "scripts": {
    "dev": "pnpm run build:content && vp dev",
    "data": "node scripts/build-dict.mjs",
    "build:content": "vpx scripts/build-content.ts",
    "audit": "vpx scripts/audit-content.ts",
    "build": "pnpm run build:content && tsc --noEmit && vp build",
    "build:cf": "(git rev-parse --is-shallow-repository | grep -q true && git fetch --unshallow --quiet); pnpm run data && pnpm run build",
    "preview": "vp preview",
    "deploy": "wrangler deploy",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.4",
    "marked": "^18.1.1",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
